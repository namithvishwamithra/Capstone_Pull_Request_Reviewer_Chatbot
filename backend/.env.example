# OAuth application credentials (keep actual secrets in backend/.env)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Generate and store these securely; do not commit real values.
SESSION_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Select google or anthropic. The selected provider key is server-only.
AI_PROVIDER=google
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_MODEL=gemma-4-26b-a4b-it
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

DATABASE_URL=sqlite:///./capstone.db
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
PRODUCTION=false
# Optional review-size override; increase cautiously because larger reviews use more AI quota.
MAX_CHANGED_LINES=1000
